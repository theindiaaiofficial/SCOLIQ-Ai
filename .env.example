# Copy to .env for local development. Do not commit .env or share its secrets.
APP_NAME=SCOLIQ AI Backend
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
SCHOOL_TIMEZONE=Asia/Kolkata

DATABASE_URL=postgresql+psycopg://smartattend:smartattend_local_only@localhost:54329/smartattend
MIGRATION_DATABASE_URL=

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64
SESSION_TTL_HOURS=12
INITIAL_ADMIN_SETUP_TOKEN=REPLACE_WITH_A_SEPARATE_ONE_TIME_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=SCOLIQ AI
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Keep manual until ONNX smoke test, model/detector checks, consent and
# threshold calibration are complete.
FACE_PROVIDER=manual
FACE_DETECTOR_MODEL_PATH=./models/face/face_detection_yunet_2023mar.onnx
FACE_DETECTOR_SCORE_THRESHOLD=0.85
FACE_DETECTOR_NMS_THRESHOLD=0.30
FACE_MIN_FACE_SIZE=64

# Qualcomm AI Hub MobileFaceNet ONNX float v0.66.0.
FACE_MOBILEFACENET_MODEL_PATH=./models/face/mobile_facenet.onnx
FACE_MOBILEFACENET_METADATA_PATH=./models/face/metadata.json
FACE_MOBILEFACENET_EXTERNAL_DATA_PATH=./models/face/mobile_facenet.data
FACE_MOBILEFACENET_MODEL_NAME=MobileFaceNet
FACE_MOBILEFACENET_MODEL_VERSION=qaihub-v0.66.0-float-onnx-ort-1.30.0
FACE_MOBILEFACENET_INPUT_SIZE=112
FACE_MOBILEFACENET_EMBEDDING_SIZE=128
FACE_MOBILEFACENET_INPUT_NAME_1=img1
FACE_MOBILEFACENET_INPUT_NAME_2=img2
FACE_MOBILEFACENET_OUTPUT_NAME=embeddings
# Do not set these to guessed values. They must be calibrated before enabling:
# FACE_MOBILEFACENET_MATCH_THRESHOLD=
# FACE_MOBILEFACENET_AMBIGUITY_MARGIN=

FACE_TEMPLATE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
FACE_MATCH_THRESHOLD=0.363
FACE_AMBIGUITY_MARGIN=0.035
MAX_FACE_UPLOAD_MB=5
MAX_FACE_IMAGE_WIDTH=4096
MAX_FACE_IMAGE_HEIGHT=4096

LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
